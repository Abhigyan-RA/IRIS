# Shadow CPI environment variables
#
# Copy this file to .env and fill in the values you need:
#     cp .env.example .env
#
# .env is git-ignored and must never be committed. This file is the reference
# for what the project needs in order to run: if you add a variable to the code,
# add it here too, with a comment saying what it is for and where to get it.
#
# Minimum to run the app: GEMINI_API_KEY and BRIGHTDATA_API_KEY. Everything else
# either has a working local default or is optional.

# --- AI -----------------------------------------------------------------
# Gemini API key. Free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model to call. The "latest" alias tracks the current recommended Flash model,
# so the app keeps working when a new version ships. Pin an explicit version
# instead (for example gemini-3.7-flash) if you need identical output over time.
GEMINI_MODEL=gemini-flash-latest
# Maximum model calls per day. A safety net against a loop running up a bill.
GEMINI_DAILY_CALL_CAP=500

# --- Bright Data Scraper Studio (for sites with no official API) ---------
# API key from your Bright Data account: https://brightdata.com/cp/setting/users
BRIGHTDATA_API_KEY=
# Which Scraper Studio collector belongs to which source, as source=collector pairs:
#     SCRAPER_STUDIO_COLLECTORS=lme_copper_scraper=c_abc123,baltic_dry_scraper=c_def456,whalewisdom_13f_scraper=c_whale123
# The WhaleWisdom source enriches only the configured fund watchlist. SEC EDGAR remains
# authoritative for shares and market value; never configure it as a site-wide crawler.
# Build a collector, which is a scraper the AI Agent writes from one sentence:
#     npx -p @brightdata/cli bdata scraper create <url> "<what to extract>"
# It prints a c_* identifier. That identifier survives self-healing, so nothing downstream
# changes when a site is redesigned. A source with no collector is skipped.
SCRAPER_STUDIO_COLLECTORS=
# When a scraper breaks because a website changed its layout, an AI proposes a
# fix. false requires human review and is the production-safe default: a generated
# repair can silently broaden URL scope, pagination, or discovery. Use true only in
# a controlled demo where that scope and cost risk is acceptable.
BRIGHTDATA_AUTO_APPROVE_HEAL=false
# Maximum scraper runs per day, to bound scraping spend.
BRIGHTDATA_DAILY_RUN_CAP=200

# --- Databases ----------------------------------------------------------
# TimescaleDB (PostgreSQL) holds price history. This default matches the local
# Docker setup in infra/docker-compose.yml.
DATABASE_URL=postgresql://shadowcpi:shadowcpi@localhost:5432/shadowcpi
# Neo4j holds supply-chain relationships. Local Docker uses bolt://localhost:7687;
# a hosted AuraDB instance looks like neo4j+s://xxxx.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# Redis backs API rate limiting and stops two schedulers running the same job.
REDIS_URL=redis://localhost:6379/0

# --- Optional keys for official data sources ----------------------------
# These are free and take a few minutes to obtain. With them, energy,
# agriculture, and filings data come from official APIs instead of scraping,
# which is faster and does not break when a website is redesigned. The app runs
# without them and falls back to scraping.
#
# Free key: https://www.eia.gov/opendata/register.php
EIA_API_KEY=
# Free key: https://mymarketnews.ams.usda.gov/mymarketnews-api
USDA_MARS_API_KEY=
# SEC does not use API keys. Instead it requires every automated client to
# identify itself with a product name and a real contact address, and throttles
# requests that do not. Put your own address here.
SEC_EDGAR_USER_AGENT=ShadowCPI/1.0 (you@example.com)

# --- App ----------------------------------------------------------------
# Public URL of the dashboard. Variables prefixed NEXT_PUBLIC_ are the only ones
# sent to the browser, so never put a secret behind that prefix.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public URL of the backend API, as the browser sees it.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Shared secret that scheduled jobs present when triggering protected endpoints.
# Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=

# --- Local container ports ----------------------------------------------
# Only needed when a port is already in use on your machine, which is common if you
# already run PostgreSQL, Neo4j, or Redis locally. Change the port here and in the
# matching connection string above; do not stop the service you already depend on.
POSTGRES_HOST_PORT=5432
NEO4J_HTTP_HOST_PORT=7474
NEO4J_BOLT_HOST_PORT=7687
REDIS_HOST_PORT=6379

# --- Backend runtime ----------------------------------------------------
# local, staging, or production. Outside local, all public URLs must use HTTPS.
APP_ENV=local
# Port the API listens on.
API_PORT=8000
# Exact browser origins allowed to call the API, comma-separated. No wildcards.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Requests per minute allowed per client IP.
RATE_LIMIT_PER_MINUTE=60
# Stricter limit for the copilot endpoint, which costs money per request.
COPILOT_RATE_LIMIT_PER_MINUTE=5
# debug, info, warning, or error.
LOG_LEVEL=info
